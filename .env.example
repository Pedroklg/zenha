# Copie para .env e preencha. O .env nunca vai para o git.

# rooms-token-server
ROOMS_BIND_ADDR=127.0.0.1:8787
ROOMS_INVITE_CODE=troque-este-codigo
# Opcional. Validade do token em segundos (1 a 86400). Padrão 3600.
ROOMS_TOKEN_TTL_SECS=3600
# Opcional. Salas fixas separadas por vírgula (a-z 0-9 - _, até 32 caracteres).
ROOMS_ROOM_LIST=geral,jogos,afk
# Opcional. Caminho do banco SQLite para mensagens salvas. Padrão chat.db no diretório atual.
# ROOMS_CHAT_DB=chat.db

# LiveKit. Em desenvolvimento, `livekit-server --dev` usa devkey / secret.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Logs: error, warn, info, debug, trace
RUST_LOG=info
